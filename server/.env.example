# server/.env 템플릿 — 이 파일을 server/.env 로 복사한 뒤 값을 채운다.
# server/.env · server/.env.local 은 gitignore — secret 커밋 금지.
#
# ⚠️ DB mismatch 주의 (docs/ops/database-environments.md)
# ─────────────────────────────────────────────────────
# Railway development UI (https://insurance-dev.up.railway.app) 는
#   development Postgres (public proxy 예: tramway.proxy.rlwy.net)
# Railway production / 로컬 server/.env 를 production proxy 로 두면
#   production Postgres (public proxy 예: shortline.proxy.rlwy.net)
# 두 인스턴스는 다릅니다. 로컬에서 724 customers 가 보여도 dev URL 에서 0 건일 수 있습니다.
#
# 로컬에서 development DB 와 맞추려면:
#   Railway → CRM-Platform → development → Postgres → Connect → Public Network URL
# 로컬에서 production 데이터를 읽기만 할 때 (주의):
#   production Postgres public URL — backfill --execute / reset 금지

# 명시적 분류 (선택). dbEnvironmentGuard 가 production execute 차단에 사용.
# INSURANCE_DB_ENVIRONMENT=development
# INSURANCE_DB_ENVIRONMENT=production
# INSURANCE_DB_ENVIRONMENT=local

# 보험 CRM 카카오 알림톡 (SMS/자동문자와 분리 — ALIGO_* SMS env 사용 금지)
# 기본 dry-run=true. 실발송은 승인 tpl_code + credentials + DRY_RUN=false 일 때만.
# INSURANCE_ALIGO_KAKAO_API_KEY=
# INSURANCE_ALIGO_KAKAO_USER_ID=
# INSURANCE_ALIGO_KAKAO_SENDER_KEY=
# INSURANCE_ALIGO_KAKAO_SENDER=
# INSURANCE_ALIGO_KAKAO_DRY_RUN=true
# INSURANCE_ALIGO_KAKAO_TEST_MODE=N
# INSURANCE_ALIGO_KAKAO_TPL_CUSTOMER_APP_LINK=PLACEHOLDER

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# 로컬 전용 override — server/.env.local 이 있으면 DATABASE_URL 등을 덮어씀
# cp server/.env.local.example server/.env.local

JWT_SECRET=change-me-local-only

# 스키마가 이미 적용된 반복 기동 (로컬만, Railway 배포 금지)
# INSURANCE_SKIP_INIT_DB=true

# 보험 CRM 결제단 Phase 1 (기본 OFF)
# INSURANCE_BILLING_ENABLED=true
# INSURANCE_BILLING_ENFORCE_ACCESS=false
# INSURANCE_BILLING_PROVIDER=mock

INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true
INSURANCE_ADMIN_BOOTSTRAP_USERNAME=admin
INSURANCE_ADMIN_BOOTSTRAP_PASSWORD=1234

# ⚠️ 1회 디버그 전용 — users DELETE CASCADE. Railway·production proxy 에서는 코드가 차단.
# INSURANCE_DEBUG_RESET_ALL_USERS=true
# INSURANCE_ALLOW_DESTRUCTIVE_RESET=I_UNDERSTAND_DELETE_USERS
