JWT_SECRET=change-this-in-production
# PostgreSQL 연결 문자열 (Railway에서 자동 제공 가능)
DATABASE_URL=postgresql://user:password@host:5432/database
VITE_API_BASE_PATH=/backend
INSURANCE_CONTACT_ADMIN_USERNAME=admin
VITE_INSURANCE_CONTACT_ADMIN_USERNAME=admin

# 로컬/스테이징: 기본값으로 서버 기동 시 admin 계정이 없으면 생성 (비번 기본 1234)
# Railway 등 운영: INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true 를 한 번 넣어야 부트스트랩이 동작합니다.
# INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true
INSURANCE_ADMIN_BOOTSTRAP_PASSWORD=1234
