JWT_SECRET=change-this-in-production
# 서버 로그 레벨 (pino). 운영 기본 info — log drain에서 trace는 과다할 수 있음
# LOG_LEVEL=info
# PostgreSQL — 로컬 PC에서 import/개발 시: Railway Postgres → Connect → Public Network URL 사용
# (postgres.railway.internal 만 있으면 로컬에서는 ENOTFOUND — 사설 DNS는 클라우드 내부에서만 동작)
DATABASE_PUBLIC_URL=
DATABASE_URL=postgresql://user:password@host:5432/database
VITE_API_BASE_PATH=/backend

# 비밀번호 재설정·SMS 인증 — 설정 시 Aligo 대신 HTTP 게이트웨이로 POST (JSON: { "phone", "message" })
# 예: EC2 중계 서버
# SMS_HTTP_GATEWAY_URL=http://100.54.92.161:3000/send-sms

# 동의서 PDF — Cloudflare R2 (미설정 시 server-data/consent-storage 로컬 폴더)
# R2_ACCOUNT_ID=
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=
# 공개 CDN(커스텀 도메인 등). 미설정 시 코드 기본값 사용.
# R2_PUBLIC_CDN_BASE=https://cdn.example.com
# 원수사 소식 presigned PUT 시 객체 Cache-Control (기본 public, max-age=31536000)
# R2_INSURER_ATTACHMENTS_CACHE_CONTROL=public, max-age=31536000
# R2 버킷 접두사 insurer/ 30일 라이프사이클은 대시보드에서 설정 — docs/ops/r2-lifecycle-insurer.md
# 한글 텍스트 drawText 시 권장: NotoSansKR-Regular.otf 경로
# CONSENT_FONT_PATH=

# 원수사 연락처 편집: JWT의 role이 staff 또는 super_admin 일 때만 허용됩니다.
# (구) INSURANCE_CONTACT_ADMIN_USERNAME / VITE_INSURANCE_CONTACT_ADMIN_USERNAME 은 더 이상 사용하지 않습니다.

# admin 계정 자동 생성: true 일 때만 기동 시 없으면 INSERT (생성 후 false 권장)
INSURANCE_ENABLE_ADMIN_BOOTSTRAP=true
INSURANCE_ADMIN_BOOTSTRAP_USERNAME=admin
INSURANCE_ADMIN_BOOTSTRAP_PASSWORD=1234

# ⚠️ 1회만: 모든 users 삭제 후 부트스트랩으로 admin 재생성할 때만 true. 사용 후 반드시 제거.
# INSURANCE_DEBUG_RESET_ALL_USERS=true

# 로그인 시 평문 비밀번호·해시까지 로그 (임시 진단용, 배포 후 끄기)
# INSURANCE_LOGIN_DEBUG=true
